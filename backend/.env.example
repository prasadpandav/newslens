# Copy to .env and fill in. Everything works with no keys at all (mock mode).

# mock | groq | gemini | openai | auto
# auto = free providers first (groq -> gemini), then OpenAI as paid last
# resort if a key is set. OpenAI only receives calls when both free
# providers are rate-limited, so normal-day cost is ~zero.
LLM_PROVIDER=mock

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional paid fallbacks, used cheapest-first and only when free providers
# are rate-limited. DeepSeek (~$0.14/M in, $0.28/M out) before OpenAI.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Deep-reasoning models for trend & forecast synthesis.
# Tasks listed in REASONING_TASKS use each provider's stronger "thinking" model
# (set below) instead of the fast base model, so trends/forecasts get more
# deliberate analysis. Leave a *_REASONING_MODEL empty to reuse that provider's
# base model. Comma-separated task names: trend, signals, micro_trend, connection.
REASONING_TASKS=signals,signals_unit,trend
# Under LLM_PROVIDER=auto, reasoning tasks try these providers in order.
REASONING_PROVIDER_ORDER=deepseek,groq,gemini,openai
GROQ_REASONING_MODEL=
GEMINI_REASONING_MODEL=gemini-2.5-flash
# deepseek-v4-pro reasons via thinking mode (the old 'deepseek-reasoner' name
# retires 2026-07-24). Effort: high | max.
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
OPENAI_REASONING_MODEL=

# DeepSeek peak-valley pricing: 2x on all items during peak hours. When avoiding
# is on (default) and LLM_PROVIDER=auto, DeepSeek is demoted behind the free
# providers during peak so it's only a last resort. Set to 0 to always keep
# DeepSeek's normal priority (pay 2x for best reasoning during peak).
DEEPSEEK_AVOID_PEAK=1
# Peak windows in UTC as half-open hour ranges. DeepSeek's declared windows are
# 01:00–04:00 and 06:00–10:00 UTC (= 09:00–12:00 and 14:00–18:00 UTC+8).
DEEPSEEK_PEAK_WINDOWS_UTC=1-4,6-10

# Google Sign-In: comma-separated allowlist of OAuth client IDs (iOS + web)
# whose ID tokens the API will accept. Blank = skip the audience check.
GOOGLE_CLIENT_ID=

# REQUIRED to use /admin/* endpoints (pipeline runs, rebuild-intel, usage).
# Blank = admin endpoints are disabled. Generate one: openssl rand -hex 24
# Use as:  curl -X POST "https://<api>/admin/run?token=<ADMIN_TOKEN>"
ADMIN_TOKEN=

# Comma-separated browser-origin allowlist for CORS. * = any origin (beta default).
# e.g. ALLOWED_ORIGINS=https://descry.example.com,http://localhost:8080
ALLOWED_ORIGINS=*

# Optional extra news source (200 free requests/day)
NEWSDATA_API_KEY=

# --- Live dynamic-hero (scores / breaking / finance / events) ---
# Free sports scores. TheSportsDB free tier: their public test key is "3".
# Get your own at https://www.thesportsdb.com/api.php. Blank = no score cards
# (breaking + finance still work).
SPORTS_API_KEY=
SPORTS_PROVIDER=thesportsdb
# Minutes between fast live refreshes (breaking sweep + sports/finance). Separate
# from the 3h story pipeline.
LIVE_REFRESH_MINUTES=5
# Finance category (news + optional keyless Stooq index snapshot). 0 to disable.
FINANCE_ENABLED=1
# Breaking heuristic thresholds.
BREAKING_MIN_SOURCES=3
BREAKING_WINDOW_HOURS=6

# Hours between automatic pipeline runs
PIPELINE_INTERVAL_HOURS=6

# --- Feed / trend / forecast ordering (app/ranking.py) ---
# Stories, trends and forecasts are ranked by impact discounted by recency, not
# by either alone: score = impact / (1 + age_in_pipeline_cycles) ^ RANK_GRAVITY.
# The most impactful item from the latest run leads; higher-impact items from a
# run or two back can still outrank a merely-average fresh one; but anything on
# the order of the retention window fades to near-zero no matter how impactful
# it once was, so stale items never park at the top. Raise RANK_GRAVITY to let
# recency dominate harder; lower it to let big stories hold their spot longer.
RANK_GRAVITY=1.5
# Ingest freshness: ignore feed entries published more than this many hours ago.
# Keep it WIDER than PIPELINE_INTERVAL_HOURS so a late or skipped run doesn't
# drop news permanently (12h gate for a 6h cadence = 2x safety margin).
# 0 disables. Entries whose feed gives no date are always kept.
INGEST_MAX_AGE_HOURS=12

# --- LLM cost controls ---
# Global cap on real LLM calls per rolling minute (all tasks + providers). Guards
# free-tier RPM (Groq is 30/min) and bounds token burn. 0 disables the cap.
LLM_MAX_CALLS_PER_MIN=30
# Near-duplicate article merging: titles at/above this cosine similarity are treated
# as the same story across sources and processed by the LLM once (sources annotated).
# Raise toward 1.0 to merge less aggressively, lower to merge more.
DEDUPE_SIMILARITY=0.62
DEDUPE_WINDOW_DAYS=7

# A trend the newest run no longer sees is RETIRED, not deleted: it leaves the
# Trends radar but its page and any shared link keep working, and it comes back
# with the same id if the story resurfaces. This is how many days a retired trend
# stays readable before it is finally deleted.
TREND_RETIRE_PURGE_DAYS=30

# --- Analytics (admin reports: visitors / traffic / users) ---
# Page views are recorded with a random id the browser mints for itself, plus the
# referring host and a country code from the edge. No IP address and no
# user-agent is ever stored. This is how long raw per-visit rows are kept; the
# daily traffic totals are aggregates and are kept indefinitely.
ANALYTICS_RETAIN_DAYS=180

# --- Grouping v2 (app/textmerge.py): TF-IDF text + proper-noun anchors ---
# A pair must clear BOTH floors and be inside the time window before it can merge.
# Score >= DEDUPE_HIGH merges outright; between LOW and HIGH it is "borderline" and
# resolved by one batched LLM call; below LOW it never merges.
DEDUPE_COS_FLOOR=0.10
DEDUPE_ANCHOR_FLOOR=0.50
DEDUPE_HIGH=0.52
DEDUPE_LOW=0.34
DEDUPE_WINDOW_HOURS=48
# Anti-chaining: a cluster member whose average similarity to the rest is below
# this is split back out (stops A~B, B~C silently merging A and C).
DEDUPE_COHESION=0.34

# Resolve borderline pairs with ONE batched LLM call. 0 = fully deterministic
# (those pairs simply stay unmerged, zero added LLM cost).
SAMESTORY_VERIFY=1
SAMESTORY_MAX_PAIRS=15

# Fuller article text for grouped stories. RSS summaries average ~150 chars, too
# thin to merge facts across outlets; fetched text is used only to build the prompt
# and is NOT stored. robots.txt is honoured. 0 = RSS summaries only.
FULLTEXT_ENABLED=1
FULLTEXT_TIMEOUT=8
FULLTEXT_MAX_CHARS=6000
FULLTEXT_MAX_PER_STORY=4
# Hard cap on the merged-fact brief handed to the LLM (token control).
BRIEF_MAX_CHARS=2600

DB_PATH=newslens.db
